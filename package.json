{
  "name": "hybrid-school",
  "version": "1.8.3",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "db:generate": "node scripts/env-run.mjs db:generate",
    "db:migrate": "node scripts/env-run.mjs db:migrate",
    "db:seed": "node scripts/env-run.mjs db:seed",
    "check": "npm run check -w backend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
