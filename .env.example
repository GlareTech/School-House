# Copy to .env at repository root. Scripts and Docker Compose use this file.
POSTGRES_USER=school
POSTGRES_PASSWORD=replace_with_random_database_password
POSTGRES_DB=school
CACHE_BACKEND=redis
DATABASE_URL=postgresql://school:replace_with_random_database_password@localhost:5432/school?schema=public&connection_limit=20&pool_timeout=10
REDIS_URL=redis://localhost:6379
PORT=3000
WEB_PORT=8080
# Exact browser origins, comma separated. Production should use the canonical
# HTTPS application URL; localhost is useful only for development.
APP_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
# Use none only for a separate HTTPS frontend origin; it requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=strict
TRUST_PROXY=0
SESSION_HOURS=12
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=replace_with_a_unique_password_16_chars_minimum
ADMIN_NAME=School Administrator
# Stable unique identifier; never reuse across independent schools.
SITE_ID=school-001
# Empty disables cloud synchronization. HTTPS required outside development.
CLOUD_SYNC_URL=
CLOUD_SYNC_TOKEN=
SYNC_INTERVAL_MS=15000
# Optional reference cloud receiver (separate deployment/database).
CLOUD_PORT=4000
LOG_LEVEL=info
# Server feature switches. Set false and restart API/worker to hide and block a module.
# Edit config/features.json for normal module on/off control. Environment values
# named FEATURE_CBT, FEATURE_ASSIGNMENTS, FEATURE_LIBRARY, FEATURE_ATTENDANCE,
# FEATURE_REPORTS, FEATURE_HOSTEL, FEATURE_PAYMENTS, FEATURE_CLOUD_SYNC,
# FEATURE_COMMUNICATIONS, FEATURE_EMAIL, or FEATURE_SMS
# take precedence when a deployment needs a locked override.
FEATURE_SETTINGS_FILE=config/features.json

# Email delivery: disabled, smtp, or console. Console is development-only.
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS delivery: disabled, generic, twilio, or console. Console is development-only.
SMS_TRANSPORT=disabled
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=Schoolhouse
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
COMMUNICATION_BATCH_SIZE=25
COMMUNICATION_MAX_ATTEMPTS=5
# Attachment and branding storage. Docker Compose overrides this with its persistent volume path.
UPLOAD_DIR=./data/uploads
# App Hosting should set this to the Firebase Storage bucket name. When set,
# uploads are stored in Cloud Storage instead of the container filesystem.
FIREBASE_STORAGE_BUCKET=
# Enables the generated Firebase SQL Connect admin connector. Leave false for
# ordinary local development unless the emulator is configured.
FIREBASE_DATA_CONNECT_ENABLED=false
