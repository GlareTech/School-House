{
  "name": "schoolhouse-saas",
  "version": "1.8.3",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm run db:generate && npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration",
    "db:generate": "node scripts/env-run.mjs db:generate",
    "db:migrate": "node scripts/env-run.mjs db:migrate",
    "db:seed": "node scripts/env-run.mjs db:seed",
    "check": "npm --prefix backend run check && npm run build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prisma": "6.12.0",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "6.12.0",
    "@schoolhouse/dataconnect-admin": "file:dataconnect-generated/admin",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.12"
  }
}
